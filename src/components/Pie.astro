---
import { tr, type Lang } from '../lib/i18n';
import { ui } from '../data/perfil';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="bg-grafito text-[#A3A8A1]">
  <div class="contenedor flex flex-wrap justify-between gap-2 py-3.5 text-sm">
    <span>© {new Date().getFullYear()} Kevin Carrasco</span>
    <span>{tr(ui.pie.hecho, lang)}</span>
  </div>
</footer>
