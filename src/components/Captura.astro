---
import { Image } from 'astro:assets';

// Captura leída del repositorio al construir; Astro la convierte a WebP en varios tamaños.
interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  carga?: 'lazy' | 'eager';
  estilo?: string;
  anchos?: number[];
}
const { src, alt, class: clase, sizes = '(max-width: 768px) 100vw, 640px', carga = 'lazy', estilo, anchos = [480, 800, 1200, 1600] } = Astro.props;
const esSvg = src.endsWith('.svg');
---

{
  esSvg ? (
    <img src={src} alt={alt} class={clase} style={estilo} loading={carga} decoding="async" />
  ) : (
    <Image src={src} alt={alt} inferSize class={clase} widths={anchos} sizes={sizes} format="webp" loading={carga} style={estilo} />
  )
}
